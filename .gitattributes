# Normalize text files to LF in the repository and working tree.
*        text=auto  eol=lf

# Source and config files should always use LF.
*.ts     text       eol=lf
*.tsx    text       eol=lf
*.js     text       eol=lf
*.jsx    text       eol=lf
*.mjs    text       eol=lf
*.json   text       eol=lf
*.jsonc  text       eol=lf
*.md     text       eol=lf
*.sh     text       eol=lf

