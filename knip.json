{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}"]
    },
    "packages/shared": {
      "entry": ["test/**/*.test.ts"],
      "project": ["**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}"]
    },
    "packages/pi-tytoo-codemode": {
      "entry": [
        "src/index.ts",
        "src/sandbox/worker.ts",
        "src/sandbox/prelude/index.ts",
        "test/**/*.test.ts",
        "test/support/fail-manifest-replacement.mjs"
      ],
      "project": ["**/*.{ts,mjs}"]
    }
  }
}
