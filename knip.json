{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"project": ["**/*.ts"]
		},
		"packages/*": {
			"entry": ["test/**/*.test.ts"],
			"project": ["**/*.ts"]
		},
		"packages/pi-*": {
			"entry": ["src/index.ts", "test/**/*.test.ts"],
			"project": ["**/*.ts"]
		}
	}
}
