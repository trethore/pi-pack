{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}"]
    },
    "packages/*": {
      "entry": ["index.ts", "src/index.ts", "test/**/*.test.ts"],
      "project": ["**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}"]
    }
  }
}
