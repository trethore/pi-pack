{
	"name": "pi-pack",
	"version": "0.0.1",
	"description": "Monorepo for the Pi extensions I develop.",
	"license": "MIT",
	"private": true,
	"engines": {
		"node": "^22.19.0 || ^24.0.0 || >=26.0.0",
		"npm": ">=12.0.0"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"check": "npm run --silent format && npm run --silent typecheck",
		"format": "prettier --log-level warn --write .",
		"format:check": "prettier --log-level warn --check .",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "22.20.5",
		"prettier": "3.9.10",
		"typescript": "7.0.2"
	},
	"type": "module"
}
