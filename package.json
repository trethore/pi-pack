{
  "name": "pi-pack",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Monorepo for pi extensions.",
  "keywords": [
    "pi-package"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "import:pi": "bash scripts/import-pi.sh",
