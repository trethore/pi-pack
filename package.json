{
	"name": "pi-pack",
	"version": "0.0.1",
	"description": "Monorepo for the Pi extensions I develop.",
	"license": "MIT",
	"private": true,
	"engines": {
		"node": "^22.19.0 || ^24.0.0 || >=26.0.0",
		"npm": ">=12.0.0"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"check": "npm run --silent format && npm run --silent typecheck && npm run --silent lint && npm run --silent test && npm run --silent knip && npm run --silent jscpd",
		"clone:pi": "node scripts/clone-pi.ts",
		"dev": "pi -e .",
		"format": "prettier --log-level warn --write .",
		"format:check": "prettier --log-level warn --check .",
		"install:pi-hello-world": "pi install ./packages/pi-hello-world",
		"jscpd": "jscpd --fail-on-empty",
		"knip": "knip",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@types/node": "22.20.5",
		"jscpd": "5.4.2",
		"knip": "6.43.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"prettier": "3.9.10",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	},
	"type": "module",
	"pi": {
		"extensions": [
			"packages/pi-*/src/index.ts"
		]
	}
}
