{
  // Enable the extension.
  "enabled": true,

  // Commands exposed only to Pi's built-in bash tool.
  // A project commands array replaces the global commands array.
  "commands": [
    {
      // Enable this command entry.
      "enabled": true,

      // Command name added to the bash tool's PATH.
      "name": "example-name",

      // Absolute path to the executable that handles the command.
      "command": "/absolute/path/to/node",

      // Optional arguments inserted before arguments supplied by the bash call.
      "args": ["/absolute/path/to/example-cli.js"],

      // Optional environment variables applied only to this command process.
      "env": {
        "EXAMPLE_MODE": "pi"
      },

      // Optional system-prompt guidance. Omit this section to keep the command situational.
      "prompt": {
        // Optional explanation of when or why the command should be used.
        "description": "Run the example project helper.",

        // Optional usage summary shown to the model.
        "usage": "example-name [options]"
      }
    }
  ]
}
