{
  "name": "@pi-pack/pi-codemode",
  "version": "0.1.0",
  "private": true,
  "description": "Run JavaScript against Pi tools in a local sandbox.",
  "keywords": [
    "pi",
    "extension",
    "codemode"
  ],
  "license": "MIT",
  "type": "module",
  "imports": {
    "#sandbox-script": "./src/sandbox/script.js",
    "#src/*": "./src/*.ts",
    "#test/*": "./test/*.ts"
  },
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.ts"
  },
  "dependencies": {
    "@earendil-works/pi-codemode": "1.6.0",
    "dedent": "^1.7.2"
  },
  "devDependencies": {
    "typebox": "^1.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
