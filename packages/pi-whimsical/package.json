{
  "name": "@pi-pack/pi-whimsical",
  "version": "0.1.0",
  "private": true,
  "description": "Replace Pi's working message with a random whimsical message on each turn.",
  "keywords": [
    "pi",
    "extension",
    "whimsical"
  ],
  "license": "MIT",
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts",
    "#test/*": "./test/*.ts"
  },
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "pi-whimsical.example.jsonc"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.ts"
  },
  "dependencies": {
    "@pi-pack/config": "0.1.0",
    "@pi-pack/events": "0.1.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
