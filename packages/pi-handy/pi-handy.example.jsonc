{
  // Master switch for pi-handy.
  "enabled": true,

  // /showsysprompt [prompt|tools]
  "showSysprompt": {
    "enabled": true
  },

  // Notify how long the agent took when it finishes.
  "timeTaken": {
    "enabled": true
  },

  // Unsafely disables Pi's five-minute idle expiry for cached Codex WebSockets.
  // Pi still replaces WebSockets at its fixed 55-minute maximum connection age.
  "noWebsocketCacheTtl": {
    "enabled": false
  }
}
