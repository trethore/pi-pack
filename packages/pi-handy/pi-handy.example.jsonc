{
  // Master switch for pi-handy.
  "enabled": true,

  // Ctrl+Shift+I sends this message. Ctrl+Alt+I appends it to the prompt box.
  "implementationPrompt": {
    "enabled": true,
    "message": "Proceed with the implementation."
  },

  // /thinkinglevel <level>
  "thinkingLevel": {
    "enabled": true
  },

  // /showsysprompt [prompt|tools]
  "showSysprompt": {
    "enabled": true
  },

  // Notify how long the agent took when it finishes.
  "timeTaken": {
    "enabled": true
  }
}
