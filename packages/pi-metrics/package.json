{
  "name": "pi-metrics",
  "version": "0.0.1",
  "description": "Show per-turn token usage, speed, duration, and estimated cost in Pi.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "metrics"
  ],
  "files": [
    "src",
    "pi-metrics.example.jsonc"
  ],
  "pi": {
