  },
  "dependencies": {
    "@pi-pack/shared": "0.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0"
  },
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "1.0.0"
  }
}
