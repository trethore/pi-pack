{
  "name": "pi-tytoo-codemode",
  "version": "0.1.0",
  "description": "Opinionated implementation of Pi's built-in codemode.",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "dist",
    "LICENSES"
  ],
  "imports": {
    "#src/*": "./src/*.ts",
    "#test/*": "./test/*.ts",
    "#scripts/*": "./scripts/*.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "@pi-pack/shared": "0.1.0",
    "quickjs-wasi": "3.6.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-agent-core": "^1.1.0",
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "typebox": "1.3.27",
    "vite": "8.3.4",
    "yaml": "2.9.0"
  },
  "scripts": {
    "build:prompts": "node scripts/build-prompts.ts",
    "build:sandbox": "npm run build:prompts && npm run typecheck:prelude && node scripts/build-sandbox.mjs",
    "typecheck:prelude": "tsc -p src/sandbox/prelude/tsconfig.json",
    "dev": "npm run build:sandbox && pi -e .",
    "prepack": "npm run build:sandbox",
    "test": "npm run build:sandbox && vitest run",
    "test:upstream": "npm run build:sandbox && vitest run test/upstream",
    "upstream:import": "node scripts/import-upstream-tests.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
