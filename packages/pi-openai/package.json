{
  "name": "pi-openai",
  "version": "0.0.1",
  "description": "Configure OpenAI-compatible request parameters in Pi.",
  "dependencies": {
    "@pi-pack/shared": "0.0.1",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "1.0.2"
  },
