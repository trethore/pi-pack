{
  "enabled": true,

  // Unsafe: bypass all support checks and infer the format from the payload.
  // Value validation, disabled settings, and payload safeguards still apply.
  "allowUnsupported": false,

  // "low", "medium", "high", or null to leave the provider payload unchanged.
  // Omitted keys inherit. Project null cancels an inherited override.
  "verbosity": null,

  // "auto", "concise", "detailed", "none", or null.
  // "none" removes reasoning.summary; null leaves the provider payload unchanged.
  "reasoningSummary": null,

  // Make native server-side web search available.
  // false leaves existing tools unchanged.
  "webSearch": false,

  // "priority" requests priority processing; "default" leaves the payload unchanged.
  "serviceTier": "default"
}
