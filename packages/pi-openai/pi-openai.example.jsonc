{
  "enabled": true,

  // Bypass provider/model support checks, not validation or API-format checks.
  // Unsupported combinations can be rejected by the server.
  "allowUnsupported": false,

  // "low", "medium", "high", or null to leave the provider payload unchanged.
  // Omitted keys inherit. Project null cancels an inherited override.
  "verbosity": null,

  // "auto", "concise", "detailed", "none", or null.
  // "none" removes reasoning.summary; null leaves the provider payload unchanged.
  "reasoningSummary": null,

  // Make native server-side web search available.
  // false leaves existing tools unchanged.
  "webSearch": false,

  // "priority" requests priority processing and adds x-codex-routing-hint on subscription and legacy Codex requests.
  // "default" leaves the payload unchanged and does not add a routing hint.
  "serviceTier": "default",

  // Set originator to codex-tui on ChatGPT subscription and legacy Codex requests.
  "codexOriginator": false
}
