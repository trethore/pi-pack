{
  "enabled": true,

  // Unsafe: bypass support checks, but retain payload and identity safeguards.
  "allowUnsupported": false,

  // Top-level settings apply to All models. Omitted keys inherit.
  // null leaves the provider payload unchanged.
  "verbosity": null,
  "reasoningSummary": null,
  "webSearch": false,
  "serviceTier": "default",

  // Exact matches; every supplied field must match.
  // Project values always override global values, regardless of specificity.
  "overrides": [
    {
      "match": { "api": "openai-responses" },
      "settings": { "reasoningSummary": "auto" }
    },
    {
      "match": { "model": "gpt-6-sol" },
      "settings": { "verbosity": "low" }
    },
    {
      "match": { "provider": "openai", "model": "gpt-6-sol" },
      "settings": { "verbosity": "medium" }
    }
  ]
}
