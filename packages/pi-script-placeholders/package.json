{
  "name": "pi-script-placeholders",
  "version": "0.0.1",
  "description": "Replace {{name}} placeholders with cached script output in system prompts and prompt templates.",
  "dependencies": {
    "@pi-pack/shared": "0.1.0"
  },
  "files": [
    "pi-script-placeholders.example.jsonc",
    "src"
  ],
  "imports": {
    "#src/*": "./src/*.ts",
    "#test/*": "./test/*.ts"
  },
  "keywords": [
    "pi-extension",
    "pi-package",
    "placeholders"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "dev": "pi -e ."
  },
  "type": "module"
}
